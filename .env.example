# Put these in hPanel > Environment variables, or in ~/dalsuits.env (home folder, survives redeploys).
# Without DB_* the admin can't save: photos would be lost on every redeploy.
# Copy into Hostinger: Node.js app > Settings > Environment variables (Import .env)
# --- MySQL (hPanel > Databases > MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_dalsuits
DB_USER=u000000000_dalsuits
DB_PASSWORD=change-me

# --- WhatsApp ---
WA_VERIFY_TOKEN=paste-the-verify-token-from-the-setup-guide
WA_TOKEN=
# Path B (Meta direct):
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
# Path A (coexistence via 360dialog): uncomment
# WA_PROVIDER=360dialog

# Host numbers that receive alerts and can send CONFIRM/DECLINE (not the bot's own number)
ADMIN_NUMBERS=254143247740,254182744059

# --- Admin dashboard at /admin ---
# Use a long password (10+ characters). SESSION_SECRET signs the login cookie: any long random string.
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=paste-a-long-random-string

# --- Optional ---
SITE_URL=https://dalsuitsbnb.com
# PAYMENT_INSTRUCTIONS=Pay via M-Pesa Till 123456, name DAL Suits BnB
# WA_TEMPLATE_ADMIN_ALERT=dal_admin_alert
# WA_TEMPLATE_GUEST_UPDATE=dal_guest_update
